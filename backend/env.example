OPENROUTER_API_KEY=
# Fallback order (first working model wins)
OPENROUTER_MODELS=google/gemini-2.0-flash-lite,openai/gpt-4o-mini,meta-llama/llama-3.1-8b-instruct
# Optional: stronger models for intent + explanation polish (OpenRouter IDs), e.g. anthropic/claude-3.5-sonnet
OPENROUTER_MODEL_INTENT=
OPENROUTER_MODEL_ENRICH=
LLM_INTENT_ENABLED=true
LLM_EXPLANATION_ENRICH_ENABLED=true
# Optional: for some enterprise setups
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: set full path to tesseract.exe if not on PATH (Windows)
TESSERACT_CMD=
